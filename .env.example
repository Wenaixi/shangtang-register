# 接码平台配置
SMS_BASE_URL=https://www.jichisms.com
SMS_TOKEN=your_token_here

# 代理配置 (HTTP/HTTPS)
HTTP_PROXY=http://127.0.0.1:10801
HTTPS_PROXY=http://127.0.0.1:10801

# 商汤项目 (从 GUI 搜索获取)
SMS_PROJECT_ID=

# 卡号类型: 1=移动, 2=联通 (留空=不限)
SMS_ASCRIPTION=

# 号段筛选 (如 170)
SMS_PARAGRAPH=

# 卡商引擎 (默认 false)
SMS_CARD_ENGINE=false
SMS_CODE_ID=

# 注册行为
REGISTER_COUNT=1
REGISTER_OUTPUT=data/export.json
